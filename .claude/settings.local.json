{
  "permissions": {
    "allow": [
      "Bash(./gradlew clean *)",
      "Bash(./gradlew test *)"
    ]
  },
  "enabledMcpjsonServers": [
    "atlassian",
    "github"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "This attempts to read '.env' which contains sensitive secrets. Block this read operation."
          }
        ]
      }
    ]
  }
}
